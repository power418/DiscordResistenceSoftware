# Discord Application Client ID
# Buat di: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_client_id_here

# Nama aplikasi yang tampil di Discord RPC
APP_NAME=software_discord_rpc

# Rich Presence asset key (upload gambar di Discord Developer Portal -> Rich Presence -> Art Assets)
# Setelah upload, masukkan nama asset key-nya di sini
# NOTE: Jika IMGUR_CLIENT_ID diisi, icon akan otomatis diambil dari exe yang terdeteksi
DISCORD_LARGE_IMAGE=your_asset_key_here
DISCORD_LARGE_TEXT=Software RPC

# Imgur Client-ID untuk auto-upload icon software ke Imgur
# Daftar gratis di: https://api.imgur.com/oauth2/addclient
# Pilih "Anonymous usage without user authorization"
# Jika diisi, icon software akan otomatis diextract dari exe dan diupload ke Imgur
IMGUR_CLIENT_ID=
